# 只把真实 Key 写入同目录的 .env；不要修改扩展文件。
DEEPSEEK_API_KEY=

# DeepSeek 官方 API 配置（查阅日期：2026-09-18）
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 普通用户通常无需修改以下值
GWT_PORT=8765
GWT_TIMEOUT_SECONDS=60
GWT_MAX_CONCURRENCY=2
GWT_RETRIES=2
GWT_MAX_BATCH_SEGMENTS=24
GWT_MAX_BATCH_CHARS=12000
GWT_MAX_OUTPUT_TOKENS=8000
GWT_TEMPERATURE=0.2
GWT_CACHE_MAX_ENTRIES=20000
